{
  "name": "factumflux-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Factumflux Portal de Proveedores - Monorepo",
  "scripts": {
    "dev:proveedor": "pnpm --filter @factumflux/portal-proveedor dev",
    "dev:backoffice": "pnpm --filter @factumflux/backoffice dev",
    "dev:landing": "pnpm --filter @factumflux/landing dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  }
}
